-- 首拉分解（brotli q11，-n 口径）
   clang.wasm                12614129
   clang.js 胶水                18682
   sysroot-wasm32.tar         1675293
   ── 首拉（只编不链）        14308104  = 14.31 MB
   lld.wasm（首次链接再拉）    8495303
   ── 三资产总量             22803407  = 22.80 MB

