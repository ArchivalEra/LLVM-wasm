# 复跑: bash m1/exp-firstload.sh
# 口径: brotli q11 + gzip -n（只量内容，不含文件名/时间戳）

ARTIFACT firstload_clang_wasm_brotli 12614129
ARTIFACT firstload_clang_js_brotli 18682
