# Einfacht.env —— LLVM-wasm 事实系统配置（本仓口径）。
# 由 reflect-hooks/einfacht-env.sh 加载；钩子语境里这是旋钮的唯一可复现来源。
export REFLECT_FACTS="FACTS.json"
export REFLECT_DOC="STATE.md"
# 扫描面：本仓的活状态文档（正文里的断言会被翻案 / 陈旧闸门查）
export REFLECT_DOCS="STATE.md,m0/RESULTS.md,m1/RESULTS.md,m1/OPT-RESULTS.md,m1/OPT-REVIEW.md,driver/RESULTS.md,package/RESULTS.md,browser/RESULTS.md"
export REFLECT_RETRACTIONS="retractions.json"
export REFLECT_QUESTIONS="questions"
# 单语仓库：只有一份 README ⇒ 切换器互链判据由闸门明说「不适用」（非静默跳过）
export REFLECT_READMES="README.md"

# ⚠️ 下面这几个旋钮**故意不配**（而不是配成空串）——空值会被 check_envfile 拦
#    （「空不是通过」），而它们的默认行为本来就是本仓想要的：
#   · REFLECT_HISTORY_SECS：本仓活状态文档没有 append-only 历史章节；
#   · REFLECT_NAKED_MIN：用默认阈值 100（小于它的整数不查，查了全是噪音）。
